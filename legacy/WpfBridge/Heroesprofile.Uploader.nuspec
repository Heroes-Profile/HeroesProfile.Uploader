<?xml version="1.0" encoding="utf-8"?>
<!-- The bridge's Squirrel package: the same id, and lib\net45 layout, the WPF uploader's 2.x releases had. -->
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Heroesprofile.Uploader</id>
    <version>2.9.1</version>
    <title>Heroesprofile.Uploader</title>
    <authors>Heroes Profile</authors>
    <description>Uploads Heroes of the Storm replays</description>
    <dependencies />
  </metadata>
  <files>
    <file src="*.*" target="lib\net45\" exclude="*.nupkg;*.pdb;*.xml" />
  </files>
</package>
