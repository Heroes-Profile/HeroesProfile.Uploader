<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The opt-in rank reader: reads players' ranks off the game's loading screen. Only the "Ranks" build
    includes it (Heroesprofile.Uploader.Desktop built with -p:IncludeRankCapture=true, published on its own
    Velopack channel, win-ranks); the normal uploader never references this project, so none of its code
    is in that build - release-desktop.yml checks.

    Windows only for now: it uses Windows' own screen capture (Windows.Graphics.Capture) and text reader
    (Windows.Media.Ocr). The 22621 SDK has the newest capture options; SupportedOSPlatformVersion keeps
    Windows 10 (2004 and later) supported.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Lets the Linux/macOS CI runners build it too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Heroesprofile.Uploader.RankCapture</RootNamespace>
    <AssemblyName>Heroesprofile.Uploader.RankCapture</AssemblyName>
    <!-- One call into Windows' capture interop goes through a COM function pointer (WindowCapture.CaptureItemForWindow). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heroesprofile.Uploader.Common\Heroesprofile.Uploader.Common.csproj" />
  </ItemGroup>

</Project>
