<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A windowed program, so Windows doesn't open a console window next to the GUI (on Linux and
         macOS this makes no difference). The command-line modes reattach to the terminal they were
         started from - see Program.AttachToParentConsole. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Heroesprofile.Uploader.Desktop</RootNamespace>
    <AssemblyName>heroesprofile-uploader</AssemblyName>
    <!-- No dependency on the distro's libicu (missing or a different soname on many distros).
         PredefinedCulturesOnly=false because NLog's JSON serializer looks up "en-US" at startup,
         which throws in invariant mode otherwise. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- HeroesProfileVersion (Directory.Build.props) unless a build passes -p:Version - release-desktop.yml
         does, adding a "-beta.N" suffix for test builds; a global property like that always wins. The
         window title, the "version" command-line option and the update checks read it back (ReleaseVersion.Current). -->
    <Version Condition="'$(Version)' == ''">$(HeroesProfileVersion)</Version>
    <!-- For the single-file Linux tarball: Skia/HarfBuzz native libs are bundled and self-extracted on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The Windows .exe's own icon (Explorer, taskbar) - the same one the WPF app used. -->
    <ApplicationIcon>Gui/Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heroesprofile.Uploader.Common\Heroesprofile.Uploader.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heroesprofile.Uploader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Gui\Assets\**" />
    <!-- Same file, also embedded under a plain reflection-friendly name so the CLI `install`
         command can extract it (for ~/.local/share/icons/...) without pulling in Avalonia. -->
    <EmbeddedResource Include="Gui\Assets\app-icon.png" LogicalName="heroesprofile-uploader-icon.png" />
  </ItemGroup>


</Project>
