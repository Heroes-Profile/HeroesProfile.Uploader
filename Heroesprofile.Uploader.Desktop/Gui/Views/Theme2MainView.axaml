<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Heroesprofile.Uploader.Desktop.Gui.ViewModels"
             xmlns:gui="clr-namespace:Heroesprofile.Uploader.Desktop.Gui"
             x:Class="Heroesprofile.Uploader.Desktop.Gui.Views.Theme2MainView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Theme 2: the main window the Linux app (PR #53, by Azax - github.com/Azax-Dev) shipped with - header with status (its pause button
    is commented out below, see MainWindowViewModel.TogglePause),
    stats grid, toggles, a replay list with time/map/status badges, Settings and a menu in the header - on the same view
    model as Theme 1, plus this app's additions (retry failed uploads, Twitch status, per-OS toggles).
    Colours and control styles: Theme/Theme2.axaml.
  -->

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header: brand + status, banners, stats grid -->
    <Border Grid.Row="0" Background="{DynamicResource AppBackgroundElevatedBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" Cursor="Hand" Background="Transparent"
                      PointerReleased="Logo_PointerReleased" ToolTip.Tip="Open heroesprofile.com">
            <!-- The Heroes Profile logo, in place of PR #53's plain green hexagon -->
            <Image Source="/Gui/Assets/icons/64.png" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Heroes Profile Uploader" FontSize="12" FontWeight="Medium" />
              <TextBlock Classes="overall" Classes.uploading="{Binding IsUploading}" Classes.failing="{Binding HasFailedUploads}"
                         Text="{Binding StatusText}" FontSize="11" />
            </StackPanel>
          </StackPanel>
          <!-- Settings, and a menu with everything used less often (in place of the footer's row of buttons) -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
            <Button Classes="icon-btn" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" Click="OpenSettings_Click">
              <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AppTextSecondaryBrush}"
                    Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
            </Button>
            <Button Classes="icon-btn" ToolTip.Tip="More" AutomationProperties.Name="More options">
              <Path Width="13" Height="3" Stretch="Uniform" Fill="{DynamicResource AppTextSecondaryBrush}"
                    Data="M1.5,0 A1.5,1.5 0 1 1 1.5,3 A1.5,1.5 0 1 1 1.5,0 Z M6.5,0 A1.5,1.5 0 1 1 6.5,3 A1.5,1.5 0 1 1 6.5,0 Z M11.5,0 A1.5,1.5 0 1 1 11.5,3 A1.5,1.5 0 1 1 11.5,0 Z" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Show log" Command="{Binding ShowLogCommand}" />
                  <MenuItem Header="Open replay folder" Command="{Binding OpenReplayFolderCommand}" />
                  <MenuItem Header="Check for update" Command="{Binding CheckForUpdateCommand}" />
                  <MenuItem Header="-" />
                  <MenuItem Header="Report an issue" Command="{Binding ReportIssueCommand}"
                            ToolTip.Tip="Opens the uploader's GitHub to report a problem - attaching your log helps" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <!--
            Pause button removed: Pausing replay uploads makes it easier for upload abusers to pause between games to remove losses from upload queue.
            (Icons drawn rather than the pause/play characters, which Windows shows as coloured emoji.)
          <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="{Binding PauseButtonTooltip}"
                  Command="{Binding TogglePauseCommand}" VerticalAlignment="Top">
            <Panel>
              <Path Data="M0,0 H3 V10 H0 Z M6,0 H9 V10 H6 Z" Fill="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding !IsPaused}" />
              <Path Data="M0,0 L9,5 L0,10 Z" Fill="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding IsPaused}" />
            </Panel>
          </Button>
          -->
        </Grid>

        <Border IsVisible="{Binding HasFailedUploads}" Background="{DynamicResource StatusErrorBrush}" CornerRadius="4" Padding="8,5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FailedUploadsText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppAccentInkBrush}" />
            <Button Grid.Column="1" Classes="link-btn" Command="{Binding RetryFailedCommand}"
                    ToolTip.Tip="Try the uploads that failed again now (they're also retried every time the uploader starts)">
              <TextBlock Text="Retry" FontWeight="SemiBold" TextDecorations="Underline" Foreground="{DynamicResource AppAccentInkBrush}" />
            </Button>
          </Grid>
        </Border>

        <Border IsVisible="{Binding ShowRestartBanner}" Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="8,5">
          <StackPanel Spacing="2">
            <TextBlock Text="An update is downloaded and will be installed when you restart the uploader."
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppAccentInkBrush}" />
            <Button Classes="link-btn" Click="RestartNow_Click">
              <TextBlock Text="Restart now." FontWeight="SemiBold" TextDecorations="Underline" Foreground="{DynamicResource AppAccentInkBrush}" />
            </Button>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding StatChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusCountViewModel">
              <Border Background="{DynamicResource AppRowAltBrush}" CornerRadius="4" Padding="5,3" Margin="2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Classes="dot" gui:StatusClass.Status="{Binding Status}" Width="6" Height="6"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10" FontWeight="Medium" Margin="4,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Toggles, two columns -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel Spacing="4">
        <UniformGrid Columns="2">
          <CheckBox Content="Postmatch page" IsChecked="{Binding PostMatchPage}" />
          <CheckBox Content="Prematch page" IsChecked="{Binding PreMatchPage}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <CheckBox Content="Twitch extension" IsChecked="{Binding TwitchExtension}"
                      ToolTip.Tip="Show your viewers your lobby, heroes and talents live. Set your uploader key in Settings." />
            <Border Background="{DynamicResource AppRowHoverBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
              <TextBlock Text="Beta" FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </Border>
          </StackPanel>
          <CheckBox Content="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray}" />
          <CheckBox Content="{Binding StartOnLoginLabel}" IsChecked="{Binding StartOnLogin}" IsVisible="{Binding SupportsStartOnLogin}" />
          <CheckBox Content="Show in app menu" IsChecked="{Binding ShowInAppMenu}" IsVisible="{Binding SupportsAppMenuEntry}" />
        </UniformGrid>
        <TextBlock Text="{Binding TwitchStatus}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource AppTextTertiaryBrush}"
                   IsVisible="{Binding TwitchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Replay list (virtualized: people have thousands of replays) -->
    <DockPanel Grid.Row="2">
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="12,5">
        <TextBlock Text="{Binding ListCaption}" FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="10" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
        <!-- "Check for update"'s result, and the link to a release that can't be installed automatically: a line
             of its own, wrapping, as "Update available: v3.0.2-beta.32 - click to open the release page." doesn't
             fit between the count and the version at Lite's width (it was cut off at 1.5x). -->
        <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="link-btn" Margin="0,3,0,0" Command="{Binding OpenUpdateCommand}"
                IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" TextWrapping="Wrap" />
        </Button>
      </Grid>
      <ListBox ItemsSource="{Binding Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReplayRowViewModel">
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
              <!-- Fixed-width id and status columns, so both line up from row to row -->
              <Grid ColumnDefinitions="Auto,*,72,100">
                <TextBlock Text="{Binding TimeText}" FontFamily="Consolas, Menlo, monospace" FontSize="10.5"
                           Foreground="{DynamicResource AppTextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock DockPanel.Dock="Right" Text="✘" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource StatusErrorBrush}"
                             IsVisible="{Binding Deleted}" ToolTip.Tip="This replay has been deleted by uploader according to your settings" />
                  <TextBlock Text="{Binding MapText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- Heroes Profile's replay id, linking to the match page (blank until it's known) -->
                <Button Grid.Column="2" Classes="link-btn" Command="{Binding OpenMatchCommand}" IsVisible="{Binding HasReplayId}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding MatchUrl}">
                  <TextBlock Text="{Binding ReplayIdText}" FontSize="10.5" TextDecorations="Underline" />
                </Button>
                <Border Grid.Column="3" Classes="badge" gui:StatusClass.Status="{Binding UploadStatus}" HorizontalAlignment="Left"
                        CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Classes="dot" gui:StatusClass.Status="{Binding UploadStatus}" Width="5" Height="5" VerticalAlignment="Center" />
                    <TextBlock Classes="statusFg" gui:StatusClass.Status="{Binding UploadStatus}"
                               Text="{Binding StatusLabel}" FontSize="10" FontWeight="Medium" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
