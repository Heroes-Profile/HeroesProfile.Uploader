<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Heroesprofile.Uploader.Linux.Gui.ViewModels"
        xmlns:conv="clr-namespace:Heroesprofile.Uploader.Linux.Gui.Converters"
        x:Class="Heroesprofile.Uploader.Linux.Gui.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel>
    <Border Padding="14,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="Settings" FontSize="13" FontWeight="Medium" />
    </Border>

    <StackPanel Margin="14,12" Spacing="14">

      <StackPanel Spacing="4">
        <TextBlock Text="Wine/Proton prefix" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding PrefixPath}" Watermark="No prefix selected" Margin="0,0,6,0" />
          <Button Grid.Column="1" Classes="btn" Content="Browse…" Click="BrowsePrefix_Click" />
        </Grid>
        <TextBlock Text="{Binding DetectLineText}" FontSize="10.5" TextWrapping="Wrap"
                    Foreground="{Binding DetectLineIsOk, Converter={x:Static conv:BoolConverters.StatusBrush}}"
                    IsVisible="{Binding DetectLineText, Converter={x:Static conv:BoolConverters.NotEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="seg" Classes.active="{Binding ThemeIsDark}" Content="Dark" Command="{Binding SelectDarkCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="seg" Classes.active="{Binding ThemeIsLight}" Content="Light" Command="{Binding SelectLightCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="seg" Classes.active="{Binding ThemeIsSystem}" Content="Follow system" Command="{Binding SelectSystemCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Webhook URL" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <TextBox Text="{Binding WebhookUrl}" Watermark="https://discord.com/api/webhooks/…" />
        <TextBlock Text="{Binding WebhookStatusText}" FontSize="10.5" TextWrapping="Wrap"
                    Foreground="{Binding WebhookIsOk, Converter={x:Static conv:BoolConverters.StatusBrush}}"
                    IsVisible="{Binding WebhookStatusText, Converter={x:Static conv:BoolConverters.NotEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Twitch uploader key" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding TwitchUploaderKey}" PasswordChar="•" Margin="0,0,6,0" />
          <Button Grid.Column="1" Classes="btn" Content="Check key" Command="{Binding CheckTwitchKeyCommand}" />
        </Grid>
        <TextBlock Text="{Binding TwitchKeyStatusText}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                    IsVisible="{Binding TwitchKeyStatusText, Converter={x:Static conv:BoolConverters.NotEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Log level" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <ComboBox ItemsSource="{x:Static vm:SettingsWindowViewModel.LogLevelLabels}" SelectedItem="{Binding SelectedLogLevelLabel}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Updates" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <CheckBox Content="Automatically check for and install updates" IsChecked="{Binding AutoUpdate}" />
        <CheckBox Content="Allow beta updates" IsChecked="{Binding AllowPreReleases}" />
      </StackPanel>

    </StackPanel>

    <Border Padding="14,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Classes="btn" Content="Cancel" Click="Cancel_Click" />
        <Button Classes="btn btn-accent" Content="Save" Click="Save_Click" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
