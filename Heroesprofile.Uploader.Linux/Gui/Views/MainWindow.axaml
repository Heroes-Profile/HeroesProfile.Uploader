<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Heroesprofile.Uploader.Linux.Gui.ViewModels"
        xmlns:conv="clr-namespace:Heroesprofile.Uploader.Linux.Gui.Converters"
        x:Class="Heroesprofile.Uploader.Linux.Gui.Views.MainWindow"
        Title="Heroes Profile Uploader"
        Icon="/Gui/Assets/app-icon.png"
        Width="450" Height="600" MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Small hexagon "logo" mark, drawn at a 20x20
         design size and scaled by whatever Viewbox hosts it. -->
    <StreamGeometry x:Key="LogoGeometry">M10,0 L20,5 L20,15 L10,20 L0,15 L0,5 Z</StreamGeometry>
  </Window.Resources>

  <Panel>

    <!-- First run / prefix not resolved -->
    <Grid IsVisible="{Binding IsEmptyState}" RowDefinitions="*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Spacing="10">
        <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
          <Path Data="{StaticResource LogoGeometry}" Fill="{DynamicResource AppRowAltBrush}" Width="20" Height="20" Stretch="Uniform" />
        </Viewbox>
        <TextBlock Text="Point me at your Wine/Proton prefix" FontSize="14" FontWeight="Medium"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="Select the prefix with Heroes of the Storm installed and I'll find your replay folder."
                   FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
          <TextBox Grid.Column="0" Text="{Binding EmptyPrefixPath}" IsReadOnly="True" Watermark="No prefix selected" Margin="0,0,6,0" />
          <Button Grid.Column="1" Classes="btn btn-accent" Content="Browse…" Click="BrowsePrefix_Click" />
        </Grid>
        <TextBlock Text="{Binding EmptyStatusText}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{Binding EmptyStatusIsOk, Converter={x:Static conv:BoolConverters.StatusBrush}}"
                   IsVisible="{Binding EmptyStatusText, Converter={x:Static conv:BoolConverters.NotEmpty}}" />
      </StackPanel>
    </Grid>

    <!-- Normal app content -->
    <Grid IsVisible="{Binding !IsEmptyState}" RowDefinitions="Auto,Auto,*,Auto">

      <!-- Header: brand + status + pause, error banner, stats grid -->
      <Border Grid.Row="0" Background="{DynamicResource AppBackgroundElevatedBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <Viewbox Width="20" Height="20">
                <Path Data="{StaticResource LogoGeometry}" Fill="{DynamicResource AppAccentBrush}" Width="20" Height="20" Stretch="Uniform" />
              </Viewbox>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Heroes Profile Uploader" FontSize="12" FontWeight="Medium" />
                <TextBlock Text="{Binding OverallStatusText}" FontSize="11"
                           Foreground="{Binding OverallStatusBrushKey, Converter={x:Static conv:StringKeyToBrushConverter.Instance}}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="icon-btn" Content="{Binding PauseButtonGlyph}"
                    ToolTip.Tip="{Binding PauseButtonTooltip}" Command="{Binding TogglePauseCommand}"
                    VerticalAlignment="Top" />
          </Grid>

          <Border IsVisible="{Binding ShowErrorBanner}" Background="{DynamicResource StatusErrorBrush}"
                  CornerRadius="4" Padding="8,5">
            <TextBlock Text="{Binding ErrorBannerText}" FontSize="11" Foreground="{DynamicResource AppAccentInkBrush}" />
          </Border>

          <Border IsVisible="{Binding ShowRestartBanner}" Background="{DynamicResource AppAccentBrush}"
                  CornerRadius="4" Padding="8,5">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding RestartBannerText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource AppAccentInkBrush}" />
              <Button Classes="link-btn" Click="RestartNow_Click" HorizontalAlignment="Left">
                <TextBlock Text="Restart now." FontWeight="SemiBold" TextDecorations="Underline"
                           Foreground="{DynamicResource AppAccentInkBrush}" />
              </Button>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding StatChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:StatChipViewModel">
                <Border Background="{DynamicResource AppRowAltBrush}" CornerRadius="4" Padding="5,3" Margin="2">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0"
                             Fill="{Binding Status, Converter={x:Static conv:UploadStatusToBrushConverter.Foreground}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="10" FontWeight="Medium" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Toggles -->
      <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="10">
          <CheckBox Grid.Row="0" Grid.Column="0" Content="Postmatch page" IsChecked="{Binding PostMatchPage}" />
          <CheckBox Grid.Row="0" Grid.Column="1" Content="Prematch page" IsChecked="{Binding PreMatchPage}" />
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <CheckBox Content="Twitch extension" IsChecked="{Binding TwitchExtension}" />
            <Border Background="{DynamicResource AppRowHoverBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
              <TextBlock Text="Beta" FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </Border>
          </StackPanel>
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" />
          <CheckBox Grid.Row="2" Grid.Column="0" Content="Start on login" IsChecked="{Binding StartOnLogin}" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="Show in app menu" IsChecked="{Binding ShowInAppMenu}" />
        </Grid>
      </Border>

      <!-- Replay list - virtualized (ListBox's default panel is a VirtualizingStackPanel) -->
      <DockPanel Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListCaption}" FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}"
                   Padding="12,5" />
        <ListBox ItemsSource="{Binding Rows}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ReplayRowViewModel">
              <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="monospace" FontSize="10.5"
                             Foreground="{DynamicResource AppTextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding MapText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Border Grid.Column="2" CornerRadius="9" Padding="7,2" VerticalAlignment="Center"
                          Background="{Binding UploadStatus, Converter={x:Static conv:UploadStatusToBrushConverter.Background}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                               Fill="{Binding UploadStatus, Converter={x:Static conv:UploadStatusToBrushConverter.Foreground}}" />
                      <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Medium"
                                 Foreground="{Binding UploadStatus, Converter={x:Static conv:UploadStatusToBrushConverter.Foreground}}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <!-- Explicit rather than relying on FluentTheme's default panel - real users have
               thousands of replays, so this list must never realize more than what's on screen. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </DockPanel>

      <!-- Footer -->
      <Border Grid.Row="3" Background="{DynamicResource AppBackgroundElevatedBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="btn" Content="Settings" Click="OpenSettings_Click" />
              <Button Classes="btn" Content="Show log" Command="{Binding ShowLogCommand}" />
              <Button Classes="btn" Content="Check for update" Command="{Binding CheckForUpdateCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" />
          </Grid>
          <Button Classes="link-btn" Content="{Binding UpdateStatusText}" Command="{Binding OpenUpdateCommand}"
                  IsVisible="{Binding UpdateStatusText, Converter={x:Static conv:BoolConverters.NotEmpty}}" />
        </StackPanel>
      </Border>

    </Grid>
  </Panel>
</Window>
