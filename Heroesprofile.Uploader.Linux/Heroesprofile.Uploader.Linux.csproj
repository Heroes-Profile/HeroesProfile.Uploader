<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Heroesprofile.Uploader.Linux</RootNamespace>
    <AssemblyName>heroesprofile-uploader</AssemblyName>
    <!-- No dependency on the distro's libicu (missing or a different soname on many distros).
         PredefinedCulturesOnly=false because NLog's JSON serializer looks up "en-US" at startup,
         which throws in invariant mode otherwise. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- Kept in step with the Windows app's AssemblyVersion by reading it straight out of its
         AssemblyInfo.cs at evaluation time, so there's only one version number to remember to bump.
         CI (release-linux.yml) still passes -p:Version=<x.y.z[-suffix]> explicitly for test builds;
         a global property set that way always wins over this plain PropertyGroup assignment, so the
         Condition below is really just "when nobody already told us the version". "Check for update"
         (Updater.cs/ReleaseVersion.cs) compares this (via AssemblyInformationalVersion) against the
         latest release that carries a Linux build. -->
    <Version Condition="'$(Version)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Heroesprofile.Uploader.Windows\Properties\AssemblyInfo.cs')), 'AssemblyVersion\("(\d+\.\d+\.\d+)').Groups[1].Value)</Version>
    <!-- Publish as one file: Skia/HarfBuzz native libs are bundled and self-extracted on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heroesprofile.Uploader.Common\Heroesprofile.Uploader.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Gui\Assets\**" />
    <!-- Same file, also embedded under a plain reflection-friendly name so the CLI `install`
         command can extract it (for ~/.local/share/icons/...) without pulling in Avalonia. -->
    <EmbeddedResource Include="Gui\Assets\app-icon.png" LogicalName="heroesprofile-uploader-icon.png" />
  </ItemGroup>


</Project>
